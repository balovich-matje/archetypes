{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "Pick your class in the first minute. Brawler, Cutpurse or Seeker — and what they become.",
	"authors": [
		"balovich-matje"
	],
	"contact": {
		"homepage": "https://github.com/balovich-matje/archetypes",
		"sources": "https://github.com/balovich-matje/archetypes"
	},
	"license": "MIT",
	"icon": "assets/archetypes/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.archetypes.Archetypes"
		],
		"client": [
			"com.archetypes.client.ArchetypesClient"
		],
		"specialities:skills": [
			"com.archetypes.compat.SpellcastingEntrypoint"
		]
	},
	"mixins": [
		"archetypes.mixins.json",
		{
			"config": "archetypes.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": "${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java_floor}",
		"fabric-api": "*",
		"player_animation_library": "*"
	}
}
